PORT=4000
DATABASE_URL="postgresql://postgres:devpassword@localhost:5432/cindyrella?schema=public"
FRONTEND_ORIGIN=http://localhost:3000
JWT_SECRET=change-me
ORDER_HOLD_HOURS=24
# Image uploads (Cloudinary). Leave blank to disable uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Email. With SMTP_HOST blank, emails are printed to the API console instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Cindyrella <no-reply@cindyrella.ph>"
CONTACT_INBOX=
# Set to the number of reverse proxies in front of the API (e.g. 1) so rate limits see real client addresses.
TRUST_PROXY=
# Optional dedicated key for encrypting 2FA secrets (defaults to one derived from JWT_SECRET).
TOTP_ENCRYPTION_KEY=

# Public address of this API (used in email links such as "unsubscribe").
PUBLIC_API_URL=
# Google sign-in (Google Cloud Console > OAuth client, type Web). Leave blank to disable.
GOOGLE_CLIENT_ID=
# "staging" enables developer-only helpers (like the test-notification button) even in a production build.
APP_ENV=
